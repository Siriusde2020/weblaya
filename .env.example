# Halo Configuration
# Copy this file to .env and modify as needed

# Port to expose Halo on the host
# Railway sets PORT automatically — no need to configure on Railway
HALO_PORT=8090

# JVM memory options
# Adjust based on your server's available memory
JVM_OPTS=-Xmx512m -Xms256m

# Timezone (e.g., UTC, America/New_York, Europe/London, Asia/Shanghai)
TZ=UTC
